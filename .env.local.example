# =============================================================================
# Supabase — cliente y servidor
# Obtener en: Supabase Dashboard → Project Settings → API
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...

# Solo server-side. NUNCA exponer al cliente ni commitear.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# Project ID (para `npm run db:types`)
SUPABASE_PROJECT_ID=your-project-ref

# =============================================================================
# Upstash Redis — rate limiting serverless-friendly
# Crear en: https://console.upstash.com/redis (free tier)
# =============================================================================
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# =============================================================================
# App
# =============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
